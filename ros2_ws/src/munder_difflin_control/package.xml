<?xml version="1.0"?>
<package format="3">
  <name>munder_difflin_control</name>
  <version>0.1.0</version>
  <description>ROS 2 side Executor for the Munder Difflin backend: grounding, MoveIt planning, hybrid grasp, e-stop, telemetry.</description>
  <maintainer email="andy@munder.difflin">Andy</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>munder_difflin_bringup</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
