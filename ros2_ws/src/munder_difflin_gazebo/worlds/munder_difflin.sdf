<?xml version="1.0"?>
<!-- Generated scene. Frame: world origin = base of panda_link0, table top at z=0, +x forward, +y robot-left.
     Model names equal config/scene.json ids exactly. -->
<sdf version="1.9">
  <world name="munder_difflin">
    <physics name="1ms" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun"><cast_shadows>false</cast_shadows><pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <model name="ground"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      <visual name="v"><pose>0 0 -0.4 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
      <pose>0 0 -0.4 0 0 0</pose></model>

    <model name="table">
      <static>true</static>
      <pose>0.3 0 -0.2 0 0 0</pose>
      <link name="link">
        
        <collision name="collision"><geometry><box><size>1.1 1.0 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.1 1.0 0.4</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="platform">
      <static>true</static>
      <pose>0.30 0.35 0.0025 0 0 0</pose>
      <link name="link">
        
        <collision name="collision"><geometry><box><size>0.14 0.14 0.005</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.14 0.14 0.005</size></box></geometry>
          <material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_cube">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <update_frequency>20</update_frequency>
      </plugin>
      <static>false</static>
      <pose>0.45 0.15 0.02 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.33333e-05</ixx><iyy>1.33333e-05</iyy><izz>1.33333e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_cube">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <update_frequency>20</update_frequency>
      </plugin>
      <static>false</static>
      <pose>0.35 -0.12 0.02 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.33333e-05</ixx><iyy>1.33333e-05</iyy><izz>1.33333e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_cylinder">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <update_frequency>20</update_frequency>
      </plugin>
      <pose>0.55 -0.05 0.04 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.06</mass><inertia><ixx>4.1375e-05</ixx><iyy>4.1375e-05</iyy><izz>1.875e-05</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="storage_box"><static>true</static><pose>0.45 -0.40 0 0 0 0</pose>
      <link name="link">
        <collision name="floor_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.26 0.26 0.01</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.26 0.26 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
        <collision name="wall_px_c"><pose>0.125 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.26 0.08</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.125 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.26 0.08</size></box></geometry>
