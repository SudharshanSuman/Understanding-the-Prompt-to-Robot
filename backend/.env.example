# Names only. Never commit real values.
# Cloud (Anthropic Messages API)
ANTHROPIC_API_KEY=
MD_CLOUD_MODEL=claude-sonnet-5-5
# Local inference (Ollama)
OLLAMA_HOST=http://localhost:11434
MD_LOCAL_MODEL=llama3.2
# NVIDIA (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Scene config (objects/destinations/poses). Defaults to munder_difflin/config/scene.json
MD_SCENE_CONFIG=
# API service (app/main.py). The service refuses to start without MD_API_TOKEN (>= 32 chars).
MD_API_TOKEN=
MD_BIND_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser origins allowed for CORS and WebSocket. '*' only with DEBUG=true.
MD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MD_TASK_RATE_PER_MIN=10
# Set true only to bind a non-loopback address on purpose.
MD_ALLOW_REMOTE=false
DEBUG=false
MD_REQUIRE_ORIGIN=false
